# PF benchmark result dirs: keep the human-readable scoreboards (.md) and
# REPORT (.md/.pdf) tracked; the underlying report.json / raw scoreboard
# json/csv dumps and full per-item traces are regenerable (rescore.py,
# experiment_report.py) and bulky, so don't track them (2026-09-16).
power-flow-agent/benchmarks/results_*/**/report.json
power-flow-agent/benchmarks/results_*/**/report.rescored.json
power-flow-agent/benchmarks/results_*/**/scoreboard.json
power-flow-agent/benchmarks/results_*/**/scoreboard.csv
power-flow-agent/benchmarks/results_*/**/scoreboard.rescored.json
power-flow-agent/benchmarks/results_*/**/scoreboard.rescored.csv
power-flow-agent/benchmarks/results_*/**/scoreboard_per_case.json
power-flow-agent/benchmarks/results_*/**/scoreboard_per_case.csv
power-flow-agent/benchmarks/results_*/**/scoreboard_per_case.rescored.json
power-flow-agent/benchmarks/results_*/**/scoreboard_per_case.rescored.csv
power-flow-agent/benchmarks/results_*/**/traces/
power-flow-agent/benchmarks/results_*/**/logs/
power-flow-agent/benchmarks/results_smoke/
!power-flow-agent/benchmarks/results_*/**/*.md
!power-flow-agent/benchmarks/results_*/**/REPORT.pdf

# The dirs below already have their raw report.json / scoreboard.json / .csv
# fully committed from before this rule existed; leave them as committed
# instead of silently marking previously-tracked files ignored.
!power-flow-agent/benchmarks/results_figures_gpt-4o-mini/**
!power-flow-agent/benchmarks/results_gemini_2_5_flash_lite/**
!power-flow-agent/benchmarks/results_gpt_4o_mini/**
!power-flow-agent/benchmarks/results_rule_based/**
!power-flow-agent/benchmarks/results_probe_legacy_superseded/**
!power-flow-agent/benchmarks/results_probe_strong_superseded/**
!power-flow-agent/benchmarks/results_stress_gpt-4o-mini/case14/report.rescored.json
!power-flow-agent/benchmarks/results_validation_gpt-4o-mini_agents/**
!power-flow-agent/benchmarks/results_validation_gpt-4o-mini_stress/**
!power-flow-agent/benchmarks/results_validation_gpt-5.4_agents/**
!power-flow-agent/benchmarks/results_validation_gpt-5.4_figure_multistep022/**
!power-flow-agent/benchmarks/results_validation_gpt-5.4_llm_only/**
!power-flow-agent/benchmarks/results_validation_gpt-5.4_prompting/**
!power-flow-agent/benchmarks/results_validation_gpt-5.4_rule_based/**
!power-flow-agent/benchmarks/results_validation_gpt-5.4_stress/**

# power-flow-agent/results/: the reorganized results tree (2026-09-23). Everything a person
# reads is tracked (REPORT.md, summary.csv, traces/*.txt, the numbered traces/*.json copies,
# config.json, raw/report.rescored.json, logs). The runner's un-rescored report.json and its
# raw per-item trace tree duplicate those and stay local.
power-flow-agent/results/**/raw/report.json
power-flow-agent/results/**/raw/report.shard*.json
power-flow-agent/results/**/raw/traces/
power-flow-agent/results/**/raw/*.pdf
